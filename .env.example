# Storage Directory
DATA_DIR=E:/dev-data

# Shared Credentials
DEV_USER=devuser
DEV_PASS=DevPassword123!
DEV_EMAIL=admin@dev.local.com

# ddclient settings for web-apps.yml
DDCLIENT_DAEMON=300
DDCLIENT_SYSLOG=no
DDCLIENT_SSL=yes
DDCLIENT_USEV4=webv4
DDCLIENT_WEBV4=https://api.ipify.org/
DDCLIENT_PROTOCOL=dyndns2
DDCLIENT_SERVER=dynv6.com
DDCLIENT_LOGIN=none

# dynv6 zone and HTTP token (leave blank until configured)
DYNV6_ZONE=
DYNV6_TOKEN=

# Public hostnames and certificate directory names for the Nginx template.
# Keep actual domain names in the ignored .env file, not in committed files.
NGINX_PRIMARY_HOSTS=your-domain.example
NGINX_PRIMARY_CERT_NAME=your-domain.example
NGINX_SECONDARY_HOSTS=www.your-domain.example
NGINX_SECONDARY_CERT_NAME=www.your-domain.example
NGINX_TLS_HOSTS=your-domain.example www.your-domain.example
