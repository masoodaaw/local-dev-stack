# Storage Directory
DATA_DIR=E:/dev-data

# Shared Credentials
DEV_USER=devuser
DEV_PASS=DevPassword123!
DEV_EMAIL=admin@dev.local.com

# ddclient settings for web-apps.yml
DDCLIENT_DAEMON=300
DDCLIENT_SYSLOG=no
DDCLIENT_SSL=yes
DDCLIENT_USEV4=webv4
DDCLIENT_WEBV4=https://api.ipify.org/
DDCLIENT_PROTOCOL=dyndns2
DDCLIENT_SERVER=dynv6.com
DDCLIENT_LOGIN=none

# dynv6 zone and HTTP token (leave blank until configured)
DYNV6_ZONE=
DYNV6_TOKEN=

# Nginx Proxy Manager (web-apps.yml). Admin UI port (use 127.0.0.1:81 to lock to loopback).
# Create proxy hosts and SSL certs in the UI — no NGINX_* hostname vars needed.
NPM_ADMIN_PORT=81
# NPM_DISABLE_IPV6=true
# TZ=UTC

# Infisical — self-hosted secrets / env / password store (HTTPS only)
# UI: https://localhost:8443 (accept the self-signed cert on first visit)
# Uses shared stack postgres (database "infisical") + redis DB index 1 — no extra DB/Redis containers.
INFISICAL_PORT=8443
INFISICAL_SITE_URL=https://localhost:8443
# Comma-separated DNS/IP SANs for the Infisical TLS certificate
INFISICAL_TLS_HOSTS=localhost,127.0.0.1
# Required — generate once and keep stable (changing ENCRYPTION_KEY makes existing secrets unreadable):
#   openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=
#   openssl rand -base64 32
INFISICAL_AUTH_SECRET=
# Optional local note of the Infisical UI admin password (recovery only; keep out of git)
# INFISICAL_ADMIN_PASSWORD=
